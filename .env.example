# Local mode is explicitly loopback-only. Never expose demo authentication.
COSHIP_MODE=development
PORT=4300
PUBLIC_URL=http://127.0.0.1:5173
COSHIP_DATA_DIR=.coship/data
# Optional: full PostgreSQL instead of embedded PostgreSQL (PGlite).
# DATABASE_URL=postgres://coship:password@127.0.0.1:5432/coship
# Enterprise configuration (no demo users):
# COSHIP_MODE=enterprise
# PUBLIC_URL=https://coship.company.example
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_DOMAIN=company.example
# For Microsoft use a tenant-specific issuer and OIDC_TENANT_ID.
# OIDC_TENANT_ID=
# COSHIP_ADMIN_EMAIL=admin@company.example
# COSHIP_ORG_NAME=Company
# COSHIP_REGION=KZ
# COSHIP_MASTER_KEY=<32 bytes as base64; generate with openssl rand -base64 32>
# COSHIP_DIRECTORY_TOKEN=<random token for the directory synchronization API>
# COSHIP_RUNNER_URL=http://private-runner:4400
# COSHIP_RUNNER_KEY=<shared random token for private API-to-runner traffic>
