{
  "name": "coship",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "coship": "dist/packages/cli/src/index.js"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/server/src/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/apps/server/src/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cli": "tsx packages/cli/src/index.ts",
    "mcp": "tsx packages/cli/src/index.ts mcp serve",
    "runner": "tsx apps/runner/src/main.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "directory:sync": "tsx scripts/sync-directory.ts",
    "format": "prettier --write apps packages scripts tests examples *.ts *.json infra/*.yaml",
    "format:check": "prettier --check apps packages scripts tests examples *.ts *.json infra/*.yaml"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@primer/octicons-react": "^19.40.0",
    "ajv": "^8.17.1",
    "commander": "^14.0.0",
    "esbuild": "^0.28.2",
    "fastify": "5.12.5",
    "jose": "^6.1.0",
    "lenis": "^1.3.26",
    "parse5": "^8.0.1",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
